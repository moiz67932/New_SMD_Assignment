<?xml version="1.0" encoding="utf-8"?>
<!-- Round play button centred on a video thumbnail (used as the foreground of an ImageView). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="52dp" android:height="52dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#99000000" /></shape>
    </item>
    <item android:width="30dp" android:height="30dp" android:gravity="center" android:drawable="@drawable/ic_play" />
</layer-list>
