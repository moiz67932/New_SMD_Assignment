<?xml version="1.0" encoding="utf-8"?>
<!-- Live video (new screen): the host sees their own camera, viewers see the host. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <FrameLayout
        android:id="@+id/liveVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/liveStatus"
        style="@style/Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/liveBadge"
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/rounded_red"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="LIVE"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/liveViewers"
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_dark"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="0 watching"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/liveHostName"
            style="@style/Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/liveClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/liveSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Switch camera"
            android:padding="13dp"
            android:src="@drawable/ic_rotate"
            android:tint="@color/white" />

        <Button
            android:id="@+id/liveEndButton"
            style="@style/TealButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_red"
            android:text="End live video" />

    </LinearLayout>

</RelativeLayout>
