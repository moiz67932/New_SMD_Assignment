<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1">

        <!-- Live camera picture (CameraX). -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_dark" />

        <!-- Grid lines are drawn into this by CameraActivity when turned on in the settings. -->
        <FrameLayout
            android:id="@+id/cameraOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/cameraHint"
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="Tap the shutter for a photo\nHold it for a video (up to 30 s)"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/cameraSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="14dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Camera settings"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/cameraRecordBadge"
            style="@style/Heading"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_red"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="● REC 0:00"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cameraCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:textColor="@color/white"
            android:textSize="96sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="14dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Close"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/galleryButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Gallery"
                android:padding="10dp"
                android:src="@drawable/ic_image"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/cameraFlashButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Flash"
                android:padding="11dp"
                android:src="@drawable/ic_flash"
                android:tint="@color/white" />

            <RelativeLayout
                android:id="@+id/shutterButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/circle_soft">

                <View
                    android:id="@+id/shutterInner"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/circle_white" />

            </RelativeLayout>

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Switch camera"
                android:padding="10dp"
                android:src="@drawable/ic_rotate"
                android:id="@+id/cameraSwitchButton"
                android:tint="@color/white" />

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle_dark"
                android:contentDescription="Effects"
                android:padding="10dp"
                android:src="@drawable/ic_smile"
                android:id="@+id/cameraEffectsButton"
                android:tint="@color/white" />

        </LinearLayout>

        <!-- TEXT mode: a story made only of words on a colour. -->
        <RelativeLayout
            android:id="@+id/textComposer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:visibility="gone">

            <EditText
                android:id="@+id/textComposerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@null"
                android:gravity="center"
                android:hint="Type something"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="180"
                android:paddingHorizontal="28dp"
                android:textColor="@color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/textComposerColors"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_above="@id/textComposerNext"
                android:layout_marginBottom="12dp"
                android:gravity="center" />

            <Button
                android:id="@+id/textComposerNext"
                style="@style/TealButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/rounded_white"
                android:text="Next"
                android:textColor="@color/primary" />

        </RelativeLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:id="@+id/modeText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeTextLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TEXT"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeTextLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeLive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeLiveLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="LIVE"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeLiveLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeStory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeStoryLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="STORY"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeStoryLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modePost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modePostLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="POST"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modePostLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeBoomerang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modeBoomerangLabel"
                style="@style/Meta"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="BOOMERANG"
                android:textColor="#CCFFFFFF" />

            <View
                android:id="@+id/modeBoomerangLine"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
